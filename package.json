{
  "name": "musicbot",
  "version": "17.0.0",
  "description": "Fast, shard-ready Discord music bot built on discord.js v14 and DisTube v5 with Components V2 controls",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node index.js",
    "shard": "node shard.js",
    "deploy": "node scripts/deploy-commands.js",
    "test": "node --test \"test/*.test.js\"",
    "check": "node scripts/check-syntax.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --audit-level=high",
    "postinstall": "node scripts/install-binaries.js"
  },
  "keywords": [
    "discord",
    "music",
    "bot",
    "distube",
    "youtube",
    "spotify",
    "soundcloud",
    "umutxyp"
  ],
  "author": "umutxyp",
  "license": "MIT",
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "@distube/direct-link": "^1.0.1",
    "@distube/spotify": "^2.0.2",
    "@supabase/supabase-js": "^2.117.3",
    "cors": "^2.8.6",
    "discord.js": "^14.27.0",
    "distube": "^5.2.3",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "koffi": "^3.3.3",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "prism-media": "^1.3.5",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "overrides": {
    "@discordjs/node-pre-gyp": {
      "tar": "^7.5.22"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "^7.0.2"
  }
}

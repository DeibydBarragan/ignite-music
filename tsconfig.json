{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "target": "es2023",
        "lib": ["es2023"],
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "strict": false,
        "skipLibCheck": true,
        "resolveJsonModule": true
    },
    "include": ["src/core/**/*.js", "src/api/contracts.js", "index.js"]
}

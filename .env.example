# ─── Discord ──────────────────────────────────────────────
# Required. Developer Portal > your application > Bot > Reset Token
DISCORD_TOKEN=
# Optional: detected from the token automatically
CLIENT_ID=
# Optional: register slash commands to one server only (instant updates while developing)
GUILD_ID=

# ─── Bot ──────────────────────────────────────────────────
STATUS=/play
EMBED_COLOR=#5865F2
SUPPORT_SERVER=
WEBSITE=
DEFAULT_LANGUAGE=en
DEFAULT_VOLUME=100
MAX_QUEUE_SIZE=500
MAX_PLAYLIST_SIZE=200
# Seconds to wait before leaving an empty voice channel / after the queue ends (0 = never)
LEAVE_ON_EMPTY=60
LEAVE_ON_FINISH=120
# How often the now-playing panel refreshes its progress bar (seconds, 0 = only on changes)
PANEL_REFRESH=20

# ─── Spotify (optional; without it only public metadata scraping is used) ──
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ─── YouTube / yt-dlp ─────────────────────────────────────
# Fix "Sign in to confirm you're not a bot": use ONE of these
COOKIES_FILE=
COOKIES_FROM_BROWSER=
YOUTUBE_PO_TOKEN=
# Auto-renew PO tokens from a local bgutil-ytdlp-pot-provider (generate_once.js).
# Takes precedence over YOUTUBE_PO_TOKEN and never expires. Empty = disabled.
POT_GENERATOR_PATH=
# Legacy alias of POT_GENERATOR_PATH kept for older installs
POT_GENERATOR=
# Extra extractor args passed to yt-dlp (advanced). Example: youtube:player_client=web_safari
YTDLP_EXTRACTOR_ARGS=
# Custom yt-dlp / ffmpeg binary paths (optional)
YTDLP_PATH=
FFMPEG_PATH=
# Max yt-dlp processes running at the same time per shard
YTDLP_CONCURRENCY=4
# Timeout in seconds for a single yt-dlp extraction
YTDLP_TIMEOUT=30
# Advanced: base URL used by the automatic yt-dlp download
YTDLP_DOWNLOAD_BASE=
# Language/region sent to YouTube's Innertube API (search, related, playlists)
INNERTUBE_HL=es
INNERTUBE_GL=CO

# ─── Proxy (optional) ─────────────────────────────────────
# Used for YouTube and all audio downloads. http(s):// and socks5:// proxies both work.
# Several proxies may be separated by commas; each guild sticks to one of them.
PROXY_URL=

# ─── Sharding ─────────────────────────────────────────────
TOTAL_SHARDS=auto
# Optional: comma-separated shard ids to spawn in this process (auto = all)
SHARD_LIST=auto
SHARD_MODE=process
SHARD_RESPAWN=true
SHARD_SPAWN_DELAY=5500
SHARD_SPAWN_TIMEOUT=60000

# ─── Paths (optional) ─────────────────────────────────────
# Runtime state (guild settings, history, sessions) and downloaded binaries
DATA_DIR=data
BIN_DIR=bin

# ─── Network / DNS (optional) ─────────────────────────────
# Fallback resolvers used when the ISP resolver times out (comma-separated)
DNS_SERVERS=1.1.1.1,8.8.8.8
# Milliseconds to wait for the system resolver before using DNS_SERVERS
DNS_LOOKUP_TIMEOUT_MS=1500

# Set to true for verbose DisTube / ffmpeg logs
DEBUG=false

# ─── Supabase (history, favorites, web playlists; optional) ──
# SUPABASE_SERVICE_ROLE_KEY is REQUIRED for the bot to write once
# supabase/migrations/20261016_lockdown_rls.sql is applied. Server-side only:
# never expose it to browsers.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── REST API / Dashboard ─────────────────────────────────
API_ENABLED=true
API_PORT=3001
# REQUIRED when API_ENABLED=true: at least 32 characters. The bot refuses to
# start with a weak, empty or default secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_SECRET=
# Comma-separated browser origins allowed to call the API (e.g.
# https://dashboard.example.com). Empty = no browser cross-origin requests;
# server-to-server clients (the Next.js BFF, curl) are unaffected.
API_ALLOWED_ORIGINS=
# Max requests per minute per IP (raise it if the dashboard polls heavily)
API_RATE_LIMIT_PER_MINUTE=120
# Public URL of this API (tunnel URL, API Gateway URL...). Announced to
# Supabase every 60s so the web dashboard finds this bot without redeploys.
# Empty = no announcement.
PUBLIC_API_URL=
# Automatically start cloudflared quick tunnel and announce URL to Supabase (true/false)
AUTO_TUNNEL=false

# ─── Voice Commands (Groq Whisper) ──────────────────────────
VOICE_ENABLED=false
GROQ_API_KEY=
VOICE_DEFAULT_WAKE_WORD=ignite
VOICE_SILENCE_DURATION_MS=1000
GROQ_VOICE_MODEL=whisper-large-v3-turbo
# Auditory confirmation via ignite-sound TTS
VOICE_TTS_FEEDBACK_ENABLED=false
IGNITE_SOUND_API_URL=http://localhost:3002
IGNITE_SOUND_API_SECRET=
